<UserControl x:Class="varManager.Ui.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:varManager.Ui"
             Loaded="LibraryView_Loaded" PreviewMouseDown="LibraryView_PreviewMouseDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <Style x:Key="PillButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#1C2026" />
            <Setter Property="BorderBrush" Value="#2F343D" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontWeight" Value="Normal" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Text}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Text}" />
                    <Setter Property="Foreground" Value="{StaticResource Page}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="PillTemplate">
            <Button Style="{StaticResource PillButton}" Content="{Binding Label}" Command="{Binding Command}" />
        </DataTemplate>

        <ItemsPanelTemplate x:Key="WrapItems">
            <WrapPanel />
        </ItemsPanelTemplate>

        <Style x:Key="StateTag" TargetType="Border">
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="#3A3F49" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StateKey}" Value="On">
                    <Setter Property="Background" Value="#BBDCFB" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="MissingDeps">
                    <Setter Property="Background" Value="{StaticResource Warning}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StateTagText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StateKey}" Value="On">
                    <Setter Property="Foreground" Value="#0E2A44" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="MissingDeps">
                    <Setter Property="Foreground" Value="#3A1D02" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Width" Value="{x:Static ui:LibraryView.TileWidth}" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="#1C2026" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#5A616E" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="Root" Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type ui:TileRow}">
            <ItemsControl ItemsSource="{Binding Tiles}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource TileButton}" AutomationProperties.Name="{Binding Title}"
                                Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <StackPanel>
                                <Grid Height="104" Background="#26364A">
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                    <Border Style="{StaticResource StateTag}">
                                        <TextBlock Text="{Binding StateText}" Style="{StaticResource StateTagText}" />
                                    </Border>
                                </Grid>
                                <StackPanel Margin="10,8">
                                    <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Caption}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <DataTemplate DataType="{x:Type ui:AuthorHeaderRow}">
            <Button Margin="0,0,12,8" HorizontalContentAlignment="Left" Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource Edge}" Padding="10,0"
                    Command="{Binding DataContext.ToggleAuthorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding Name}">
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="16" Height="16" Margin="0,0,10,0">
                        <Canvas Width="24" Height="24">
                            <Path Data="{Binding Chevron}" Stroke="{StaticResource Text}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <Style x:Key="PlainRow" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,16,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Library" FontSize="22" FontWeight="SemiBold" Margin="0,0,12,0" />
            <TextBlock Text="{Binding ShownText}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,20,10">
            <Border Background="#1C2026" BorderBrush="{StaticResource ControlEdge}" BorderThickness="1" CornerRadius="6" Padding="8,4">
                <WrapPanel>
                    <ItemsControl ItemsSource="{Binding AuthorTags}" ItemsPanel="{StaticResource WrapItems}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#3B3220" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="6"
                                        Margin="0,2,6,2" Padding="10,0,2,0" MinHeight="36">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding}" FontWeight="Medium" VerticalAlignment="Center" />
                                        <Button Content="×" MinHeight="32" Width="32" Padding="0" Margin="6,0,0,0" Background="Transparent" BorderThickness="0"
                                                AutomationProperties.Name="{Binding StringFormat=Remove {0}}"
                                                Command="{Binding DataContext.RemoveAuthorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid MinWidth="320">
                        <TextBox x:Name="SearchBox" AutomationProperties.Name="Search packages and authors"
                                 Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0"
                                 MinHeight="38" PreviewKeyDown="SearchBox_PreviewKeyDown" />
                        <TextBlock Text="{Binding SearchHint}" Foreground="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </WrapPanel>
            </Border>
            <Popup IsOpen="{Binding HasSuggestions, Mode=OneWay}" PlacementTarget="{Binding ElementName=SearchBox}" Placement="Bottom"
                   StaysOpen="True" AllowsTransparency="True">
                <Border Width="480" Margin="0,4,0,0" Padding="4" Background="{StaticResource Control}"
                        BorderBrush="{StaticResource ControlEdge}" BorderThickness="1" CornerRadius="6">
                    <ItemsControl ItemsSource="{Binding Suggestions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="10,0"
                                        Command="{Binding DataContext.AddAuthorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Name}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Width="300" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource MutedText}">
                                            <Run Text="Author · " /><Run Text="{Binding Packages, Mode=OneWay}" /><Run Text=" packages" />
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Popup>
        </Grid>

        <ItemsControl Grid.Row="2" AutomationProperties.Name="Type" ItemsSource="{Binding TypePills}" ItemsPanel="{StaticResource WrapItems}"
                      ItemTemplate="{StaticResource PillTemplate}" Focusable="False" />
        <ItemsControl Grid.Row="3" AutomationProperties.Name="Status" ItemsSource="{Binding StatePills}" ItemsPanel="{StaticResource WrapItems}"
                      ItemTemplate="{StaticResource PillTemplate}" Focusable="False" Margin="0,0,0,6" />

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="Gallery" AutomationProperties.Name="Packages" ItemsSource="{Binding Rows}" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource PlainRow}" HorizontalContentAlignment="Stretch"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" SizeChanged="Gallery_SizeChanged" />

            <Border Grid.Column="1" Width="320" Margin="4,0,20,16" Padding="16" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}"
                    BorderThickness="1" CornerRadius="8" Visibility="{Binding HasSelection, Converter={StaticResource Visible}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Height="150" Margin="0,0,0,12">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Background" Value="#26364A" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasMovePlan}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Image Source="{Binding Selected.Thumbnail}" Stretch="UniformToFill" />
                        </Grid>
                        <TextBlock Text="{Binding Selected.Item.Package}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Selected.Item.VarName}" FontFamily="Consolas" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Status" Foreground="{StaticResource Muted}" FontSize="13" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedState}" FontSize="13" />
                            <TextBlock Grid.Row="1" Text="Type" Foreground="{StaticResource Muted}" FontSize="13" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Selected.Item.Type}" FontSize="13" />
                            <TextBlock Grid.Row="2" Text="Size" Foreground="{StaticResource Muted}" FontSize="13" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedSize}" FontSize="13" />
                            <TextBlock Grid.Row="3" Text="Needs" Foreground="{StaticResource Muted}" FontSize="13" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedNeeds}" FontSize="13" />
                        </Grid>
                        <Button Content="{Binding ToggleLabel}" Style="{StaticResource PrimaryButton}" Command="{Binding ToggleCommand}"
                                IsEnabled="{Binding DataContext.Jobs.IsIdle, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,8" />
                        <Button Content="Load in VaM" Command="{Binding LoadCommand}" Margin="0,0,0,8"
                                IsEnabled="{Binding DataContext.Jobs.IsIdle, RelativeSource={RelativeSource AncestorType=Window}}"
                                Visibility="{Binding CanLoad, Converter={StaticResource Visible}}" />
                        <Button Content="Find missing on Hub" Margin="0,0,0,8"
                                Command="{Binding DataContext.GoToMissingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Visibility="{Binding Selected.HasMissing, Converter={StaticResource Visible}}" />
                        <Button Content="Move out of library" Command="{Binding PlanMoveCommand}" Margin="0,0,0,8"
                                IsEnabled="{Binding DataContext.Jobs.IsIdle, RelativeSource={RelativeSource AncestorType=Window}}"
                                Visibility="{Binding CanMove, Converter={StaticResource Visible}}" />
                        <TextBlock Text="{Binding BlockedText}" Foreground="{StaticResource Warning}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Visibility="{Binding IsBlocked, Converter={StaticResource Visible}}" />
                        <Border BorderBrush="{StaticResource Warning}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12"
                                Visibility="{Binding HasMovePlan, Converter={StaticResource Visible}}">
                            <StackPanel>
                                <TextBlock FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6">
                                    <Run Text="Move out " /><Run Text="{Binding Selected.Item.Package, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding MoveWarning}" Foreground="{StaticResource Warning}" FontSize="12" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding MoveLines}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource Edge}" BorderThickness="0,1,0,0" Padding="0,6">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding State}" Style="{StaticResource MutedText}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Files go to a holding folder. Nothing is deleted, and you can undo." Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap" Margin="0,6,0,8" />
                                <UniformGrid Columns="2">
                                    <Button Content="Cancel" Command="{Binding CancelMoveCommand}" Margin="0,0,4,0" />
                                    <Button Content="{Binding ConfirmMoveLabel}" Style="{StaticResource PrimaryButton}" Command="{Binding ConfirmMoveCommand}" Margin="4,0,0,0"
                                            IsEnabled="{Binding DataContext.Jobs.IsIdle, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding SelectedDependencies}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Edge}" BorderThickness="0,1,0,0" Padding="0,6">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding State}" FontSize="12" Margin="10,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StateKey}" Value="On">
                                                                <Setter Property="Foreground" Value="#A9D2FA" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StateKey}" Value="MissingDeps">
                                                                <Setter Property="Foreground" Value="{StaticResource Warning}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
