<UserControl x:Class="varManager.Ui.HubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:varManager.Ui">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <Style x:Key="PlainRow" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type ui:HubRow}">
            <ItemsControl ItemsSource="{Binding Tiles}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="240" Margin="0,0,12,12" Background="#1C2026" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <Grid Height="124" Background="#26364A">
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                </Grid>
                                <StackPanel Margin="10,8">
                                    <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Caption}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />
                                    <Button Content="{Binding ActionLabel}" Style="{StaticResource PrimaryButton}"
                                            AutomationProperties.Name="{Binding Title, StringFormat=Get {0}}"
                                            Command="{Binding DataContext.GetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                            IsEnabled="{Binding DataContext.Jobs.IsIdle, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Visibility="{Binding CanGet, Converter={StaticResource Visible}}" />
                                    <Button Content="{Binding ActionLabel}"
                                            Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                            Visibility="{Binding CanOpen, Converter={StaticResource Visible}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="20,16,0,8">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Hub" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Browse and get packages" Style="{StaticResource MutedText}" Margin="12,0,12,0" VerticalAlignment="Center" />
            <Button Content="Back to Missing" Command="{Binding DataContext.LeaveHubCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        </StackPanel>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <WrapPanel Margin="0,0,20,6">
            <ComboBox AutomationProperties.Name="Pay type" ItemsSource="{Binding PayTypes}" SelectedItem="{Binding PayType}" Margin="0,0,8,6" />
            <ComboBox AutomationProperties.Name="Location" ItemsSource="{Binding Locations}" SelectedItem="{Binding Location}" Margin="0,0,8,6" />
            <ComboBox AutomationProperties.Name="Type" ItemsSource="{Binding Types}" SelectedItem="{Binding Type}" Margin="0,0,8,6" />
            <ComboBox AutomationProperties.Name="Tag" ItemsSource="{Binding Tags}" SelectedItem="{Binding Tag}" Margin="0,0,8,6" />
            <ComboBox AutomationProperties.Name="Sort" ItemsSource="{Binding Sorts}" SelectedItem="{Binding Sort}" Margin="0,0,8,6" />
            <CheckBox AutomationProperties.Name="Not owned" Content="Not owned" IsChecked="{Binding NotOwned}" VerticalAlignment="Center" Foreground="{StaticResource Text}" Margin="4,0,0,6" />
        </WrapPanel>

        <DockPanel Grid.Row="1" Margin="0,0,20,10">
            <Button DockPanel.Dock="Right" Content="Search" Command="{Binding SearchCommand}" Margin="8,0,0,0" />
            <Grid DockPanel.Dock="Left" Width="240" Margin="0,0,8,0">
                <TextBox x:Name="AuthorBox" AutomationProperties.Name="Author" Text="{Binding CreatorText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Author" Foreground="{StaticResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=AuthorBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Popup IsOpen="{Binding HasSuggestions, Mode=OneWay}" PlacementTarget="{Binding ElementName=AuthorBox}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                    <Border Width="240" Padding="4" Background="{StaticResource Control}" BorderBrush="{StaticResource ControlEdge}" BorderThickness="1" CornerRadius="6">
                        <ItemsControl ItemsSource="{Binding Suggestions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0"
                                            Command="{Binding DataContext.PickCreatorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Popup>
            </Grid>
            <Button DockPanel.Dock="Left" Content="Clear author" Command="{Binding ClearCreatorCommand}" Margin="0,0,8,0"
                    Visibility="{Binding HasCreator, Converter={StaticResource Visible}}" />
            <TextBox AutomationProperties.Name="Search the Hub" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                </TextBox.InputBindings>
            </TextBox>
        </DockPanel>

        <ListBox x:Name="Gallery" Grid.Row="2" AutomationProperties.Name="Hub packages" ItemsSource="{Binding Rows}" Background="Transparent" BorderThickness="0"
                 ItemContainerStyle="{StaticResource PlainRow}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" SizeChanged="Gallery_SizeChanged" />

        <DockPanel Grid.Row="3" Margin="0,8,20,0">
            <TextBlock DockPanel.Dock="Left" Text="{Binding StatusText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Previous" Command="{Binding PreviousCommand}" IsEnabled="{Binding CanGoBack}" Margin="0,0,8,0" />
                <TextBlock Text="{Binding PageText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Button Content="Next" Command="{Binding NextCommand}" IsEnabled="{Binding CanGoOn}" />
            </StackPanel>
        </DockPanel>
    </Grid>
    </DockPanel>
</UserControl>
