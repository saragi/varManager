<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" PrivateAssets="all" />
  </ItemGroup>

  <!-- The Core tests run here too, because the new app runs Core on .NET 10 and the old app on .NET Framework. -->
  <ItemGroup>
    <Compile Include="..\varManager.Tests\*.cs" Link="Core\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\varManager.App\varManager.App.csproj" />
    <ProjectReference Include="..\..\varManager.Core\varManager.Core.csproj" />
  </ItemGroup>

</Project>
