<Window x:Class="varManager.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="varManager" Width="1280" Height="800" MinWidth="900" MinHeight="560"
        Background="{StaticResource Page}" Foreground="{StaticResource Text}" FontFamily="Segoe UI" FontSize="14"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource Bar}" BorderBrush="{StaticResource Edge}" BorderThickness="0,0,0,1" Padding="20,10">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="varManager" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,24,0" />
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Visibility="{Binding IsReady, Converter={StaticResource Visible}}">
                    <TextBlock Text="Profile" Style="{StaticResource MutedText}" Margin="0,0,8,0" />
                    <ComboBox AutomationProperties.Name="Profile" ItemsSource="{Binding Switches}" SelectedItem="{Binding SelectedSwitch}"
                              IsEnabled="{Binding Jobs.IsIdle}" />
                    <TextBlock Text="{Binding LinkedText}" Style="{StaticResource MutedText}" Margin="12,0,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding IsReady, Converter={StaticResource Visible}}">
                    <Button Content="Update DB" Command="{Binding UpdateCommand}" IsEnabled="{Binding Jobs.IsIdle}" Margin="0,0,12,0" />
                    <Button Content="Launch VaM" Style="{StaticResource PrimaryButton}" Command="{Binding LaunchCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Visibility="{Binding IsReady, Converter={StaticResource Visible}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource Side}" BorderBrush="{StaticResource Edge}" BorderThickness="0,0,1,0" Padding="12">
                <ListBox AutomationProperties.Name="Main" Background="Transparent" BorderThickness="0"
                         ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}"
                         ItemContainerStyle="{StaticResource NavItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="18" Height="18" Margin="0,0,10,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{Binding Icon}" Stroke="{StaticResource Text}" StrokeThickness="1.8"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <StackPanel Grid.Column="1" Margin="20">
                <TextBlock Text="{Binding SelectedPage.Name}" FontSize="22" FontWeight="SemiBold" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Visibility="{Binding NeedsSetup, Converter={StaticResource Visible}}"
                HorizontalAlignment="Center" VerticalAlignment="Center" Width="560" Padding="24"
                Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="8">
            <StackPanel>
                <TextBlock Text="Set up varManager" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16" />
                <TextBlock Text="VaM folder" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                <DockPanel Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Content="Browse" Margin="8,0,0,0" Click="BrowseVam_Click" />
                    <TextBox AutomationProperties.Name="VaM folder" Text="{Binding VamPath, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
                <TextBlock Text="Vars folder" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                <DockPanel Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Content="Browse" Margin="8,0,0,0" Click="BrowseVars_Click" />
                    <TextBox AutomationProperties.Name="Vars folder" Text="{Binding VarsPath, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
                <TextBlock Text="{Binding SetupProblem}" Foreground="{StaticResource Warning}" TextWrapping="Wrap" Margin="0,0,0,12" />
                <Button Content="Continue" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Command="{Binding SaveSetupCommand}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource Bar}" BorderBrush="{StaticResource Edge}" BorderThickness="0,1,0,0"
                Padding="20,8" MinHeight="60">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelCommand}"
                        Visibility="{Binding Jobs.IsRunning, Converter={StaticResource Visible}}" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Jobs.Name}" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <StackPanel Orientation="Horizontal" Visibility="{Binding Jobs.IsRunning, Converter={StaticResource Visible}}">
                        <ProgressBar Value="{Binding Jobs.Percent, Mode=OneWay}" Maximum="100" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource MutedText}" Margin="14,0">
                            <Run Text="{Binding Jobs.Percent, Mode=OneWay}" /><Run Text="%" />
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Text="{Binding Jobs.Note}" Style="{StaticResource MutedText}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
