<UserControl x:Class="varManager.Ui.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <Style x:Key="PillButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#1C2026" />
            <Setter Property="BorderBrush" Value="#2F343D" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontWeight" Value="Normal" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Text}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Text}" />
                    <Setter Property="Foreground" Value="{StaticResource Page}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PanelBox" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,20,14" />
        </Style>

        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,16,0,8">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="Profiles" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="Each profile links only what it needs" Style="{StaticResource MutedText}" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <ItemsControl AutomationProperties.Name="Profile cards" ItemsSource="{Binding Cards}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource PanelBox}" Width="320" Margin="0,0,14,14">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <Border DockPanel.Dock="Right" Background="#3B3220" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="4" Padding="6,1"
                                            Visibility="{Binding IsActive, Converter={StaticResource Visible}}">
                                        <TextBlock Text="Active" FontSize="12" Foreground="{StaticResource Accent}" />
                                    </Border>
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <TextBlock Text="{Binding CountText}" Style="{StaticResource MutedText}" Margin="0,0,0,10" />
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Startup}" Style="{StaticResource StatValue}" />
                                        <TextBlock Text="VaM startup" Style="{StaticResource StatLabel}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding SceneLoad}" Style="{StaticResource StatValue}" />
                                        <TextBlock Text="Scene load" Style="{StaticResource StatLabel}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding Ram}" Style="{StaticResource StatValue}" />
                                        <TextBlock Text="RAM" Style="{StaticResource StatLabel}" />
                                    </StackPanel>
                                </Grid>
                                <Button Content="{Binding UseLabel}" AutomationProperties.Name="{Binding UseLabel}" Margin="0,0,0,6"
                                        IsEnabled="{Binding IsInactive}"
                                        Command="{Binding DataContext.UseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                <UniformGrid Rows="1">
                                    <Button Content="Check" Margin="0,0,4,0" Visibility="{Binding CanCheck, Converter={StaticResource Visible}}"
                                            Command="{Binding DataContext.CheckCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <Button Content="Rename" Margin="0,0,4,0" Visibility="{Binding CanChange, Converter={StaticResource Visible}}"
                                            Command="{Binding DataContext.RenameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <Button Content="Delete" Visibility="{Binding CanChange, Converter={StaticResource Visible}}"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Button Content="Save a list of linked vars" Click="ExportList_Click" Margin="0,0,8,0"
                        IsEnabled="{Binding DataContext.Jobs.IsIdle, RelativeSource={RelativeSource AncestorType=Window}}" />
                <Button Content="Turn on from a list" Click="ImportList_Click"
                        IsEnabled="{Binding DataContext.Jobs.IsIdle, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>

            <Border Style="{StaticResource PanelBox}" Visibility="{Binding IsRenaming, Converter={StaticResource Visible}}">
                <StackPanel>
                    <TextBlock Text="{Binding RenameTitle}" Style="{StaticResource PanelTitle}" />
                    <TextBox AutomationProperties.Name="New profile name" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Rename profile" Style="{StaticResource PrimaryButton}" Command="{Binding ConfirmRenameCommand}" IsEnabled="{Binding CanRename}" Margin="0,0,8,0" />
                        <Button Content="Keep name" Command="{Binding CancelChangeCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PanelBox}" Visibility="{Binding IsDeleting, Converter={StaticResource Visible}}">
                <StackPanel>
                    <TextBlock Text="{Binding DeleteText}" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Delete profile" Style="{StaticResource PrimaryButton}" Command="{Binding ConfirmDeleteCommand}" Margin="0,0,8,0" />
                        <Button Content="Keep profile" Command="{Binding CancelChangeCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PanelBox}" Visibility="{Binding HasCheck, Converter={StaticResource Visible}}">
                <StackPanel>
                    <TextBlock Text="{Binding CheckTitle}" Style="{StaticResource PanelTitle}" />
                    <TextBox AutomationProperties.Name="Profile check result" Text="{Binding CheckText, Mode=OneWay}" IsReadOnly="True" MaxHeight="240"
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" VerticalContentAlignment="Top" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Repair" Style="{StaticResource PrimaryButton}" Command="{Binding RepairCommand}" IsEnabled="{Binding CanRepair}" Margin="0,0,8,0" />
                        <Button Content="Restore previous" Command="{Binding RestoreCommand}" IsEnabled="{Binding CanRestore}" Margin="0,0,8,0" />
                        <Button Content="Close" Command="{Binding CloseCheckCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PanelBox}">
                <StackPanel>
                    <TextBlock Text="New profile" Style="{StaticResource PanelTitle}" />
                    <ItemsControl ItemsSource="{Binding ModePills}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label}" Command="{Binding Command}" Style="{StaticResource PillButton}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Visibility="{Binding NoPicks, Converter={StaticResource Visible}}">
                        <TextBlock Text="No picks yet. Pick packages in Library, then come back here." Style="{StaticResource MutedText}" Margin="0,4,0,10" />
                        <Button Content="Go to Library" Command="{Binding GoToLibraryCommand}" HorizontalAlignment="Left" Margin="0,0,0,10" />
                        <DockPanel>
                            <TextBlock Text="Name" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Button DockPanel.Dock="Right" Content="Make an empty profile" Command="{Binding MakeEmptyCommand}" IsEnabled="{Binding CanMakeEmpty}" Margin="10,0,0,0" />
                            <TextBox AutomationProperties.Name="Empty profile name" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                    </StackPanel>

                    <StackPanel Visibility="{Binding HasPicks, Converter={StaticResource Visible}}">
                        <TextBlock Text="{Binding PlanText}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,10" />
                        <ItemsControl AutomationProperties.Name="Picks" ItemsSource="{Binding PickRows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,4">
                                        <Button DockPanel.Dock="Right" Content="Remove" AutomationProperties.Name="{Binding StringFormat=Remove {0}}"
                                                Command="{Binding DataContext.RemovePickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DockPanel Margin="0,4,0,10">
                            <TextBlock DockPanel.Dock="Right" Text="Always included" Style="{StaticResource MutedText}" />
                            <TextBlock Text="Base set: session plugins, default scene, base.txt" />
                        </DockPanel>
                        <TextBox AutomationProperties.Name="Plan details" Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True" MaxHeight="220"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Margin="0,0,0,10" />
                        <DockPanel>
                            <TextBlock Text="Name" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Button DockPanel.Dock="Right" Content="Save and switch" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}"
                                    IsEnabled="{Binding CanSave}" Margin="10,0,0,0" />
                            <TextBox AutomationProperties.Name="Profile name" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <TextBlock Text="{Binding NameProblem}" Foreground="{StaticResource Warning}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
