<UserControl x:Class="varManager.Ui.MissingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <Style x:Key="PillButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#1C2026" />
            <Setter Property="BorderBrush" Value="#2F343D" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontWeight" Value="Normal" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Text}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Text}" />
                    <Setter Property="Foreground" Value="{StaticResource Page}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PanelBox" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,20,14" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,16,0,8">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="Missing" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="Checked when you open this page and after every library change" Style="{StaticResource MutedText}" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding ScopePills}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Label}" Command="{Binding Command}" Style="{StaticResource PillButton}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource PanelBox}" Margin="0,6,20,14">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <Button Content="{Binding GetAllLabel}" Style="{StaticResource PrimaryButton}" Command="{Binding GetAllCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"
                            IsEnabled="{Binding DataContext.Jobs.IsIdle, RelativeSource={RelativeSource AncestorType=Window}}"
                            Visibility="{Binding CanGetAll, Converter={StaticResource Visible}}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PanelBox}">
                <ItemsControl AutomationProperties.Name="Missing groups" ItemsSource="{Binding Groups}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Count}" FontSize="22" FontWeight="SemiBold" Width="72" VerticalAlignment="Center" />
                                <Button DockPanel.Dock="Right" Content="{Binding ActionLabel}" Command="{Binding Action}" Margin="8,0,0,0"
                                        IsEnabled="{Binding DataContext.Jobs.IsIdle, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Visibility="{Binding HasAction, Converter={StaticResource Visible}}" />
                                <Button DockPanel.Dock="Right" Content="Show" AutomationProperties.Name="{Binding Title, StringFormat=Show {0}}" Margin="8,0,0,0"
                                        Command="{Binding DataContext.ToggleLinesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                        Visibility="{Binding HasLines, Converter={StaticResource Visible}}" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Text}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Border Style="{StaticResource PanelBox}" Visibility="{Binding HasOpenGroup, Converter={StaticResource Visible}}">
                <StackPanel>
                    <TextBlock Text="{Binding OpenGroup.Title}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                        <ItemsControl AutomationProperties.Name="Group details" ItemsSource="{Binding OpenLines}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
